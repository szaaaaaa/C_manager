root ::= "{" ws "\"goal\":" ws goal "," ws "\"finding\":" ws finding "," ws "\"evidence_ids\":" ws refs "," ws "\"missing\":" ws missing "," ws "\"tool\":" ws tool "}" ws
goal ::= __GOAL__
finding ::= __FINDING__
refs ::= __REFS__
missing ::= __MISSING__
tool ::= __TOOLS__
search ::= "{" ws "\"action\":\"search\"," ws "\"query\":" ws query "," ws "\"site\":" ws site "}" ws
open-page ::= "{" ws "\"action\":\"open_page\"," ws "\"source_id\":" ws read-id "," ws "\"focus\":" ws short "}" ws
find-in-page ::= "{" ws "\"action\":\"find_in_page\"," ws "\"source_id\":" ws doc-id "," ws "\"terms\":" ws short "}" ws
review-source ::= "{" ws "\"action\":\"review_source\"," ws "\"source_id\":" ws review-id "," ws "\"relation\":" ws relation "," ws "\"note\":" ws short "}" ws
review-id ::= (__REVIEW_ID__) ws
relation ::= "\"relevant\"" | "\"unrelated\"" | "\"uncertain\""
reject-sources ::= "{" ws "\"action\":\"reject_sources\"," ws "\"source_ids\":" ws "[" ws pending-id ("," ws pending-id){0,4} "]" ws "," ws "\"reason\":" ws short "}" ws
pending-id ::= (__PENDING_IDS__) ws
finish ::= "{" ws "\"action\":\"finish\"" ws "}" ws
query ::= "\"" query-char{0,80} [一-鿿] query-char{0,39} "\"" ws
query-char ::= [^"\\:@\x00-\x1F]
short ::= "\"" char{1,30} "\"" ws
read-id ::= (__READ_IDS__) ws
doc-id ::= (__DOC_IDS__) ws
ref-id ::= (__REF_IDS__) ws
site ::= (__SITES__) ws
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
ws ::= [ \t\n\r]*
